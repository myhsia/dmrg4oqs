{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit",  "resource": "*", "effect": "allow" },
    { "action": "edit",  "resource": ".git/**", "effect": "deny" },
    { "action": "edit",  "resource": "**/__pycache__/**", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm .git/**", "effect": "deny" },
    { "action": "shell", "resource": "rm **/__pycache__/**", "effect": "deny" }
  ],
  "compaction": {
    "auto": false,
    "keep": { "tokens": 60000 },
    "buffer": 25000
  }
}
